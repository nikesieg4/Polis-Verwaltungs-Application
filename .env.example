# Kopieren nach .env – das Setup-Skript erstellt die Datei automatisch.

# Discord Developer Portal → Anwendung → Bot → Token
DISCORD_TOKEN=
# Application ID (wird nur für den Einladungslink genutzt)
CLIENT_ID=1574700107566284830

# Datenbank: leer = automatisch (D1 wenn unten ausgefüllt, sonst lokale SQLite-Datei)
DB_DRIVER=
SQLITE_PATH=./data/bcpp.db

# Cloudflare D1 (optional)
# API-Token braucht die Berechtigung „Account → D1 → Edit“
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=
